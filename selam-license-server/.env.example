# Selam license server — example env. Copy to .env.local for dev.
# In Vercel production, set these in Project Settings → Environment Variables.

# ─── Database (Vercel Postgres) ─────────────────────────────────────
# Vercel auto-injects all four when you link a Postgres database via
# the Vercel dashboard. For local dev with `vercel env pull`, they
# come down to .env.local automatically.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ─── Email (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=re_your_key_here
RESEND_FROM=Selam <support@heyselam.app>
# Domain must be verified in Resend dashboard with DKIM/SPF before
# the FROM address will deliver successfully.

# ─── Stripe (webhook + checkout) ────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Founder price ($199) — used while active licenses < FOUNDER_CAP (100).
STRIPE_PRICE_ID=price_xxx
# Standard price ($299, one year of updates) — used after the founder cap.
# Checkout fails closed (503) if the cap is reached and this is unset.
STRIPE_PRICE_ID_STANDARD=price_xxx

# ─── License key signing (optional, for v2) ─────────────────────────
# Currently we just validate by lookup. Once we add signed keys, this
# is the secret used to sign + verify them.
LICENSE_SIGNING_SECRET=

# ─── Rate limiting (Vercel KV) ──────────────────────────────────────
# Optional: if KV is provisioned, the rate limiter uses it for
# multi-instance correctness. Without these, falls back to in-memory
# (single-instance only — fine for dev, not for prod scaling).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Misc ──────────────────────────────────────────────────────────
# Origin allowed to POST to /api/recover from a browser. Defaults to
# heyselam.app; set to '*' for testing only.
ALLOWED_RECOVERY_ORIGIN=https://heyselam.app
